{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "../dist-electron",
    "rootDir": "..",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // 每次 npm run dev 都会重编一遍主进程,全量重编要 3~4s。
    // incremental 把 .tsbuildinfo 落在 dist-electron/,二次启动只重编改动过的文件。
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["shared/*"],
      "@core/*": ["core/*"]
    }
  },
  "include": ["**/*", "../shared/**/*", "../core/**/*"],
  "exclude": ["../node_modules", "../dist", "../renderer", "../workers"]
}
